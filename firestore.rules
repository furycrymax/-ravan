rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unexpected paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStatus(status) {
      return status in ['not_started', 'studying', 'summarized', 'tested', 'mastered', 'in_progress', 'completed', 'review_needed'];
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket listing forbidden

      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.userId == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;

      allow delete: if isOwner(userId);

      // Subcollection: Chapter study progress and notes
      match /progress/{chapterId} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(chapterId)
          && request.resource.data.userId == userId
          && request.resource.data.chapterId == chapterId
          && isValidStatus(request.resource.data.status)
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 5000));

        allow delete: if isOwner(userId);
      }

      // Subcollection: Saved Search Grounding insights
      match /researches/{researchId} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(researchId)
          && request.resource.data.userId == userId
          && request.resource.data.query is string
          && request.resource.data.query.size() <= 1000
          && request.resource.data.responseText is string
          && request.resource.data.responseText.size() <= 50000;

        allow delete: if isOwner(userId);
      }
    }
  }
}
